{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.nexus.localai",
  "productName": "NEXUS",
  "directories": {
    "output": "../../release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../web/out",
      "to": "web-out"
    }
  ],
  "win": {
    "target": ["nsis"],
    "artifactName": "NEXUS-Setup-${version}.${ext}"
  },
  "mac": {
    "target": ["dmg"],
    "artifactName": "NEXUS-${version}.${ext}"
  },
  "linux": {
    "target": ["AppImage"],
    "artifactName": "NEXUS-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  }
}
